{
  "name": "@wayfinder/adapters",
  "version": "1.1.0",
  "type": "module",
  "description": "Framework adapters — Drizzle, Better Auth, Vercel AI SDK, LangGraph, health checks, logging, observability.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bootstrap": {
      "types": "./src/bootstrap.ts",
      "default": "./src/bootstrap.ts"
    },
    "./db": {
      "types": "./src/db/index.ts",
      "default": "./src/db/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:drift": "node scripts/check-schema-drift.mjs",
    "db:rehearse-upgrade": "vitest run --config vitest.rehearsal.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@wayfinder/domain": "workspace:*",
    "@wayfinder/shared": "workspace:*",
    "@types/lodash": "^4.17.24",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.7",
    "lodash": "^4.18.1",
    "minio": "^8.0.7",
    "nodemailer": "^10.1.4",
    "pdf-parse": "^2.4.5",
    "pizzip": "^3.2.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^2.0.110",
    "@ai-sdk/mistral": "^2.0.53",
    "@ai-sdk/openai": "^2.0.136",
    "@langchain/core": "^1.2.20",
    "@langchain/langgraph": "^1.5.2",
    "ai": "^5.0.279",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "langfuse": "^3.30.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "langfuse": {
      "optional": true
    },
    "pino-pretty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/amazon-bedrock": "^3.0.141",
    "@ai-sdk/anthropic": "^2.0.110",
    "@ai-sdk/mistral": "^2.0.53",
    "@ai-sdk/openai": "^2.0.136",
    "@ai-sdk/provider": "^2.0.5",
    "@langchain/core": "^1.2.20",
    "@langchain/langgraph": "^1.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.12",
    "ai": "^5.0.279",
    "better-auth": "~1.7.14",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "langfuse": "^3.30.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
