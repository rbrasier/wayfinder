# Never ship configuration or secrets — the image is environment-agnostic and a
# deployment's integrations are configured in the setup wizard (ADR-041).
.env
.env.*
!.env.example
!.env.min.example.*

# Build output and caches: rebuilt inside the image, and copying host artifacts
# in would silently mix architectures.
node_modules
**/node_modules
.next
**/.next
dist
**/dist
.turbo
**/.turbo
coverage
**/coverage

# The Lambda deployment target is not part of any container image. It sits
# outside the pnpm workspace so its dependencies never reach the image; this
# keeps its source out too, since the Dockerfile copies the whole tree
# (ADR-056 §2).
deploy

# Repository and tooling noise that only slows the build context transfer.
.git
.github
.claude
docs
*.md
!README.md
test-results
playwright-report
**/*.tsbuildinfo
