{
  "name": "wayfinder",
  "version": "0.27.5",
  "private": true,
  "description": "Wayfinder — AI-guided workflow agent for document-heavy processes.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @rbrasier/adapters db:generate",
    "db:migrate": "pnpm --filter @rbrasier/adapters db:migrate",
    "db:check": "pnpm --filter @rbrasier/adapters db:check",
    "db:drift": "pnpm --filter @rbrasier/adapters db:drift",
    "validate": "./validate.sh",
    "restart": "./restart.sh",
    "init": "./scripts/init-project.sh",
    "framework:update": "./scripts/update-framework.sh"
  },
  "pnpm": {
    "overrides": {
      "langsmith": ">=0.6.0",
      "vitest": "^4.1.0",
      "vite": "^6",
      "@grpc/grpc-js": ">=1.14.4",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "fast-uri": ">=3.1.5 <4",
      "sharp": ">=0.35.0",
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.18",
      "better-auth": ">=1.6.22 <1.7.0",
      "protobufjs": ">=7.6.1",
      "adm-zip": ">=0.6.0",
      "nanoid@3": ">=3.3.18 <4",
      "nanoid@5": ">=5.1.16 <6",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": ">=4.3.1 <5",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "ip-address": ">=10.3.1"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
