{
  "name": "wayfinder",
  "version": "0.40.2",
  "private": true,
  "description": "Wayfinder \u2014 AI-guided workflow agent for document-heavy processes.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @wayfinder/adapters db:generate",
    "db:migrate": "pnpm --filter @wayfinder/adapters db:migrate",
    "db:check": "pnpm --filter @wayfinder/adapters db:check",
    "db:drift": "pnpm --filter @wayfinder/adapters db:drift",
    "validate": "./validate.sh",
    "restart": "./restart.sh"
  },
  "pnpm": {
    "overrides": {
      "langsmith": ">=0.6.0",
      "vitest": "^4.1.11",
      "vite": "^6.4.4",
      "@grpc/grpc-js": ">=1.14.5",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "fast-uri": ">=3.1.8 <4",
      "sharp": ">=0.35.5",
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.18",
      "better-auth": ">=1.6.22 <1.7.0",
      "protobufjs": ">=8.6.6 <9",
      "adm-zip": ">=0.6.1",
      "nanoid@3": ">=3.3.18 <4",
      "nanoid@5": ">=5.1.16 <6",
      "js-yaml@3": ">=3.15.2 <4",
      "js-yaml@4": ">=4.3.2 <5",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "ip-address": ">=10.7.1 <11",
      "browserslist": ">=4.28.7",
      "jsondiffpatch": ">=0.7.6",
      "@xmldom/xmldom": ">=0.9.12 <0.10",
      "nodemailer": ">=10.0.6 <11",
      "next": ">=15.5.28 <16",
      "source-map-js": ">=1.2.2",
      "proxy-addr": ">=2.0.8",
      "qs": ">=6.16.0 <7",
      "body-parser@1": ">=1.20.6 <2",
      "hono": ">=4.13.7 <5",
      "@hono/node-server": ">=1.19.15 <2",
      "@opentelemetry/core": ">=2.8.0 <3",
      "fast-copy": ">=4.1.0 <5",
      "uuid@9": "^11.1.1",
      "uuid@10": "^11.1.1",
      "zod@4": ">=4.6.6 <5"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.3",
    "turbo": "^2.9.14",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
