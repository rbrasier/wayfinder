{
  "name": "@wayfinder/api",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "DOTENV_CONFIG_PATH=../../.env tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/cli/migrate.js",
    "recover-admin": "DOTENV_CONFIG_PATH=../../.env tsx src/cli/recover-admin.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@wayfinder/adapters": "workspace:*",
    "@wayfinder/application": "workspace:*",
    "@wayfinder/domain": "workspace:*",
    "@wayfinder/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
